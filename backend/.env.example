# Copy to .env (or set these in Emergent's environment settings). Never commit real keys.
ANTHROPIC_API_KEY=
# Any current Claude model id. claude-haiku-5-5 costs a small fraction of claude-opus-5-5 per answer.
LLM_MODEL=claude-opus-5-5
# Comma-separated origins allowed to call the API (the deployed site, plus local dev).
ALLOWED_ORIGINS=http://localhost:5173
# Requests per IP per window, to protect the credits.
RATE_LIMIT=20
RATE_WINDOW_SECONDS=600
# Requests for the whole site per day; past it, visitors get the offline answers.
DAILY_LIMIT=300
